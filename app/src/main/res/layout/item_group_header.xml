<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_group_header"
    android:paddingLeft="18dp"
    android:paddingRight="6dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:gravity="center_vertical"
    android:layout_marginLeft="14dp"
    android:layout_marginRight="14dp"
    android:layout_marginTop="20dp">

    <TextView
        android:id="@+id/tvGroupName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/md_on_primary_container"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:ellipsize="end"
        android:maxLines="1"/>

    <Button
        android:id="@+id/btnCheckGroup"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="▶"
        android:textColor="@color/md_on_primary_container"
        android:textSize="13sp"
        android:textAllCaps="false"
        android:background="@android:color/transparent"
        android:padding="0dp"/>

    <Button
        android:id="@+id/btnEditGroup"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="✏"
        android:textColor="@color/md_primary"
        android:textSize="13sp"
        android:textAllCaps="false"
        android:background="@android:color/transparent"
        android:padding="0dp"/>

    <Button
        android:id="@+id/btnDeleteGroup"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="🗑"
        android:textColor="@color/md_error"
        android:textSize="13sp"
        android:textAllCaps="false"
        android:background="@android:color/transparent"
        android:padding="0dp"/>

</LinearLayout>
