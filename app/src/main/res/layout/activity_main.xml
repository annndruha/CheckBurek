<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:fitsSystemWindows="true">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="8dp"
        android:paddingBottom="96dp"
        android:clipToPadding="false"
        android:scrollbars="none"/>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabCheckAll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="Проверить всё"
        android:textColor="@color/md_on_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/md_primary"
        app:icon="@drawable/ic_cached"
        app:iconTint="@color/md_on_primary"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>